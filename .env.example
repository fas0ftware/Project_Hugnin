# Copy to .env and fill in. Never commit .env.
# Telegram bot token from @BotFather (only needed for hugnin_bot.py)
TELEGRAM_TOKEN=your-telegram-bot-token
# Comma-separated chat ids allowed to use the bot. Empty = nobody.
# Send /start to the bot once; the refused chat id appears in the bot's log.
ALLOWED_CHAT_IDS=
# Which watchlist group to scan: all, us, us-tech, us-finance, us-health, us-consumer,
# us-industrial, us-energy-utilities, bist, crypto
HUGNIN_GROUP=all
